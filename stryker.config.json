{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/core/**/*.ts",
    "src/effects/curves.ts",
    "src/effects/points.ts",
    "src/effects/colorspace.ts",
    "src/engine/render-cache/*.ts",
    "src/engine/memory.ts",
    "src/engine/tracking/tracker.ts",
    "!src/core/rpc.ts",
    "!src/core/emitter.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp"
}
